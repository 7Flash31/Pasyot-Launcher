<Window x:Class="Pasyot_Launcher.Views.AddModpackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Добавить сборку"
        Height="540" Width="480"
        MinHeight="540" MinWidth="440"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Resources/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Добавить сборку" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CancelButton_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource OutlineIconStyle}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Файл сборки (.pasyotpack)"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="PackPathTextBox"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource SurfaceAltBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="10,0"
                                     IsReadOnly="True"
                                     Text="Файл не выбран, или перетащите его в окно лаунчера"/>

                            <Button Grid.Column="1"
                                    Content="Обзор..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Width="90"
                                    Margin="10,0,0,0"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="InfoPanel"
                        Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="16"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Информация о сборке"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Название:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                            <TextBlock x:Name="ModpackNameText" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="90,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Загрузчик:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                            <TextBlock x:Name="ModpackLoaderText" Text="—" Foreground="{StaticResource TextPrimaryBrush}" Margin="90,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Minecraft:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                            <TextBlock x:Name="ModpackMinecraftText" Text="—" Foreground="{StaticResource TextPrimaryBrush}" Margin="90,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Версия:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                            <TextBlock x:Name="ModpackVersionText" Text="—" Foreground="{StaticResource TextPrimaryBrush}" Margin="90,0,0,0"/>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Сервер:" Foreground="{StaticResource TextSecondaryBrush}" Width="90"/>
                            <TextBlock x:Name="ModpackServerText" Text="—" Foreground="{StaticResource TextPrimaryBrush}" Margin="90,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Width="100"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button x:Name="AddButton"
                            Content="Добавить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="13"
                            Height="38" Width="120"
                            IsEnabled="False"
                            Click="AddButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
