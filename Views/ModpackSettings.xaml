<Window x:Class="Pasyot_Launcher.Views.ModpackSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки" Height="705" Width="600"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="4"/>

                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <TextBlock x:Name="PlaceholderText" 
                                       Text="{TemplateBinding Tag}" 
                                       Foreground="#777777" 
                                       Margin="{TemplateBinding Padding}" 
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                       IsHitTestVisible="False" 
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="BackgroundEllipse" Width="18" Height="18" Fill="#007ACC"/>
                            <Ellipse Width="8" Height="8" Fill="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="#007ACC"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="0,3,3,0" Background="#333333"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A4A4C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Папка с профилями:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ProfilesPathTextBox" 
                                 Grid.Column="0"
                                 Style="{StaticResource PlaceholderTextBoxStyle}"
                                 Tag="C:\Users\Username\AppData\Roaming\.pasyot\profiles" 
                                 Height="35" HorizontalAlignment="Left" Width="450"/>

                        <Button Content="Обзор"
                                Style="{StaticResource BrowseButtonStyle}"
                                Height="35"
                                Margin="470,0,0,0"
                                Cursor="Hand"
                                Click="BrowseProfilesFolder_Click" Grid.ColumnSpan="2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Выделение оперативной памяти (ОЗУ):" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="RamTextBox" 
                                     Text="{Binding ElementName=RamSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F0}}" 
                                     Width="65" 
                                     Height="25" 
                                     TextAlignment="Center" 
                                     VerticalContentAlignment="Center"
                                     Background="#333333" 
                                     Foreground="White" 
                                     BorderThickness="1" 
                                     BorderBrush="#444444"/>
                            <TextBlock Text=" МБ" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Slider x:Name="RamSlider" 
                            Style="{StaticResource CustomSliderStyle}"
                            Minimum="1024" 
                            Maximum="16384" 
                            Value="4096" 
                            TickFrequency="512" 
                            IsSnapToTickEnabled="True" 
                            IsMoveToPointEnabled="True" 
                            Margin="0,10,0,0"/>

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="1024 МБ" Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="MaxRamLabel" Text="16384 МБ" Foreground="#888888" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Адрес сервера (API):" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="ServerUrlTextBox" 
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Tag="https://pasyot.com" 
                             Height="35"/>
                </StackPanel>
            </Border>

            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Аргументы Java (JVM Flags):" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="JavaArgsTextBox" 
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Tag="-XX:+UseG1GC -Dsun.rmi.dgc.server.gcInterval=2147483647" 
                             Height="35" 
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Переменные среды (Environment Variables):" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="EnvVarsTextBox" 
                             Style="{StaticResource PlaceholderTextBoxStyle}"
                             Tag="KEY=VALUE;OTHER_KEY=VALUE" 
                             Height="35"/>
                    <TextBlock Text="Разделяйте переменные точкой с запятой (;)" 
                               Foreground="#888888" 
                               FontSize="11" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="Сохранить настройки" 
                    Click="SaveButton_Click" 
                    Height="40" 
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>