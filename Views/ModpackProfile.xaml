<UserControl x:Class="Pasyot_Launcher.Views.ModpackProfile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pasyot_Launcher.Views"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="220">

    <UserControl.Resources>
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Width="210"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}"
            Padding="14"
            Margin="0,0,10,10"
            Cursor="Hand"
            MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">

        <Border.Background>
            <SolidColorBrush Color="#1E1E22"/>
        </Border.Background>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>
            <Grid>
                <Ellipse x:Name="IconEllipse" Width="44" Height="44" Fill="{StaticResource SurfaceAltBrush}" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource DeleteButtonStyle}"
                            ToolTip="Настройки сборки"
                            Click="SettingsButton_Click">
                        <Path Data="{StaticResource IconSettings}" Style="{StaticResource OutlineIconStyle}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Button x:Name="DeleteButton"
                            Style="{StaticResource DeleteButtonStyle}"
                            ToolTip="Удалить сборку"
                            Click="DeleteButton_Click">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource OutlineIconStyle}" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ModpackName" Text="Sample Modpack"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="MinecraftVersion" Text="Sample Version"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <Border x:Name="LoaderBadge"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="3"
                        Padding="5,1"
                        Margin="6,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="LoaderBadgeText"
                               Text="FABRIC"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <Border x:Name="UpdateBadge"
                    Background="{StaticResource SuccessBackgroundBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    ToolTip="Доступно обновление">
                <TextBlock Text="ОБНОВЛЕНИЕ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
            </Border>

            <Border x:Name="LocalChangesBadge"
                    Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <TextBlock x:Name="LocalChangesBadgeText" Text="1 ФАЙЛ ИЗМЕНЁН" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
