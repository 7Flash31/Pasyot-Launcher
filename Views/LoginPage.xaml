<Page x:Class="Pasyot_Launcher.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LoginPage" Foreground="White">

    <Page.Resources>
        <Style x:Key="LaunchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="#181818" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Border Background="#202020" 
                CornerRadius="12" 
                Padding="30" 
                Width="340" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center">

            <StackPanel>
                <TextBlock Text="Авторизация"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,6"
                           HorizontalAlignment="Center"/>

                <Button x:Name="LoginBtn"
                        Content="Войти через Vedrow"
                        Height="42"
                        Style="{StaticResource LaunchButtonStyle}"
                        Click="LoginBtn_Click"
                        Cursor="Hand"/>

                <TextBlock x:Name="LoginStatusText"
                           Text="Открываем браузер для авторизации..."
                           FontSize="11"
                           Foreground="#888888"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>