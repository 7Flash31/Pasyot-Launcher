<Window x:Class="Pasyot_Launcher.Views.ModpackSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Настройки сборки"
        Height="560" Width="460"
        MinHeight="420" MinWidth="380"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Icon="/Resources/app.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Настройки сборки" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource OutlineIconStyle}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock x:Name="PackNameText" Text="Sample Modpack" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="PackSubtitleText" Text="—" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ChangedFilesHeaderText" Grid.Column="0" Text="Изменённые локально файлы" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            x:Name="RefreshButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="28" Height="28"
                            ToolTip="Проверить ещё раз"
                            Click="RefreshButton_Click">
                        <TextBlock x:Name="RefreshIconText" Text="&#8635;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <TextBlock x:Name="StatusText"
                                   Text="Проверка файлов..."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="16"/>

                        <ListBox x:Name="ChangedFilesList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4"
                                 Visibility="Collapsed">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Закрыть"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Width="100"
                            Margin="0,0,10,0"
                            Click="CloseButton_Click"/>

                    <Button x:Name="ResetButton"
                            Content="Сбросить сборку"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{StaticResource ErrorBrush}"
                            FontSize="13"
                            Height="38" Width="160"
                            Click="ResetButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
