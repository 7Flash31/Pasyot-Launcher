<Window x:Class="Pasyot_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pasyot_Launcher"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="LaunchMinecraftBtn" Content="Button" HorizontalAlignment="Center" VerticalAlignment="Center" Height="65" Width="170" Click="LaunchMinecraftBtn_Click"/>
        <ProgressBar x:Name="FileProgressBar" HorizontalAlignment="Center" Height="10" Margin="0,289,0,0" VerticalAlignment="Top" Width="160"/>
        <ProgressBar x:Name="ByteProgressBar" HorizontalAlignment="Center" Height="10" Margin="0,324,0,0" VerticalAlignment="Top" Width="160"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
            <Ellipse Width="50" Height="50" Fill="Black" Cursor="Arrow"/>
            <TextBlock Text="Sapmle Text"  FontWeight="SemiBold"  FontSize="15" Height="20" Margin="9.5,0,0,0" Cursor="Hand"/>
        </StackPanel>
        <ListView d:ItemsSource="{d:SampleData ItemCount=50}" Margin="10,127,648,140">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
