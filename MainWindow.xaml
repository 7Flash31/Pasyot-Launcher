<Window x:Class="Pasyot_Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Pasyot_Launcher"
        mc:Ignorable="d"
        Title="Pasyot Launcher" Height="640" Width="1020"
        MinHeight="540" MinWidth="900"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Resources/app.ico" Width="18" Height="18"/>
                    <TextBlock Text="Pasyot Launcher" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource IconButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click">
                        <Path Data="{StaticResource IconMinimize}" Style="{StaticResource OutlineIconStyle}" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource OutlineIconStyle}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,18,14,18">
                        <Border x:Name="ProfileArea"
                                Background="Transparent"
                                Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseLeftButtonUp="ProfileArea_MouseLeftButtonUp">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource SurfaceAltBrush}">
                                    <Ellipse x:Name="ProfileIcon" Width="30" Height="30" Fill="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock x:Name="ProfileText" Text="Player" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Popup x:Name="ProfileMenuPopup"
                               PlacementTarget="{Binding ElementName=ProfileArea}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,6,0,0">
                                <Button x:Name="LogoutButton"
                                        Content="Выйти"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34" Width="110"
                                        Click="LogoutButton_Click"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="10,4,10,10">
                        <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Checked="NavHome_Checked">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Path Data="{StaticResource IconPlay}" Style="{StaticResource FilledIconStyle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Главная" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavLibrary" GroupName="Nav" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavLibrary_Checked">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Path Data="{StaticResource IconLibrary}" Style="{StaticResource OutlineIconStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Мои сборки" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSkin" GroupName="Nav" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavSkin_Checked">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Path Data="{StaticResource IconSkin}" Style="{StaticResource FilledIconStyle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Скин" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource SidebarNavButtonStyle}" Checked="NavSettings_Checked">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Path Data="{StaticResource IconSettings}" Style="{StaticResource OutlineIconStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Настройки" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
                    <ContentControl x:Name="PageHost"/>
                </Border>

                <Frame x:Name="MainFrame" Grid.Column="0" Grid.ColumnSpan="2" Content="Frame" NavigationUIVisibility="Hidden" Background="{StaticResource WindowBackgroundBrush}"/>

                <StackPanel x:Name="ToastHost"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0,0,20,20"
                            Width="320"/>
            </Grid>
        </Grid>
    </Border>
</Window>
